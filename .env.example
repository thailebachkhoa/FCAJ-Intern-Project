DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=

# ==== Cognito Hosted UI (đăng nhập bằng Google) ====
# Region của User Pool, VD: ap-southeast-1
COGNITO_REGION=ap-southeast-1
# User pool ID, dạng ap-southeast-1_xxxxxxxxx
COGNITO_USER_POOL_ID=
# App client ID (App integration > App clients)
COGNITO_APP_CLIENT_ID=
# Chỉ điền nếu App client có "Generate a client secret". Để trống nếu là public client.
COGNITO_APP_CLIENT_SECRET=
# Chỉ phần prefix Cognito domain, KHÔNG kèm https:// hay .auth...amazoncognito.com
COGNITO_DOMAIN=COGNITO_DOMAIN=ap-southeast-1ktatxhqoq
# Phải khớp NGUYÊN VĂN với 1 URL trong "Allowed callback URLs" của App client
COGNITO_REDIRECT_URI=http://localhost/plantify/public/auth/callback

# ==== TOTP (Google Authenticator bắt buộc cho Admin) ====
ADMIN_TOTP_ISSUER=Plantify Co
